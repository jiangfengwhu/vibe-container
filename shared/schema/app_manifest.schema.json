{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iprod.local/schemas/app_manifest.schema.json",
  "title": "Local App Workbench Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "icon",
    "entry",
    "permissions",
    "createdAt",
    "runtimeVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!https?://).+\\.html$"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "storage",
          "secureStorage",
          "notification",
          "network",
          "device",
          "ui",
          "clipboard",
          "share",
          "open",
          "file",
          "media",
          "location",
          "haptics",
          "barcode",
          "audio",
          "biometric",
          "contacts",
          "calendar",
          "download",
          "events"
        ]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1
    },
    "networkAllowlist": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9.-]+$"
      }
    },
    "signature": {
      "type": ["string", "null"],
      "default": null
    }
  }
}
